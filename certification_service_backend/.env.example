# Application
APP_NAME=Certification Service Backend
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# CORS (comma separated for origins, methods, headers)
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Database - use env vars provided by certification_service_db container
# Example using postgres+asyncpg URL style:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/certification_db
DATABASE_URL=

# External integrations (optional)
GITLAB_BASE_URL=
GITLAB_TOKEN=
SITE_URL=
