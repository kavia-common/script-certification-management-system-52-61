# Application
APP_NAME=Certification Service Backend
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# CORS
# Comma-separated list or single origin, e.g., http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Database (Async SQLAlchemy URL). Example for PostgreSQL with asyncpg:
# postgresql+asyncpg://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/certification_db

# Integrations (optional for later features)
GITLAB_BASE_URL=
GITLAB_TOKEN=
SITE_URL=
